# Stripe — compte Astre (live). Préférer une clé restreinte rk_live_ si possible.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Exposée au navigateur (Payment Element). Doit être la pk_live_ du même compte.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# xAI — clé serveur uniquement. La voix temps réel utilise un jeton éphémère.
# Modèle vocal : grok-voice-latest (jamais exposé dans l’interface).
XAI_API_KEY=xai-...

# URL HTTPS publique (retour 3DS, Apple Pay). Jamais checkout.stripe.com.
# Ex. https://lunara-xi-drab.vercel.app ou https://callastral.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret HMAC des sessions (cookie httpOnly). Obligatoire en production.
# openssl rand -base64 32
AUTH_SECRET=

# Taux indicatifs EUR → devise (affichage et encaissement Stripe). Optionnels.
# FX_EUR_USD=1.08
# FX_EUR_GBP=0.84
# FX_EUR_JPY=172
# FX_EUR_CHF=0.94
# FX_EUR_CAD=1.47

# Profils officiels pour le schema.org sameAs, séparés par des virgules.
# Laisser vide tant que les comptes n’existent pas.
# SITE_SAME_AS=https://www.instagram.com/callastral,https://www.facebook.com/callastral
SITE_SAME_AS=

# Clé IndexNow (8 à 128 caractères : lettres, chiffres, tirets). Optionnelle.
# Si elle est définie, https://hôte/<clé>.txt renvoie la clé en texte brut.
# INDEXNOW_KEY=

# Supabase (schéma callastral, clé service_role côté serveur uniquement)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# E-mails transactionnels (Resend). Laisser vide tant que l'envoi n'est pas branché.
RESEND_API_KEY=

# Protège /api/cron/* : en-tête Authorization: Bearer <valeur>.
CRON_SECRET=

# Hash bcrypt du mot de passe admin. Vide = /admin désactivé. Jamais le mot de passe en clair.
ADMIN_PASSWORD_HASH=

# Vercel KV (optional - fallback if Supabase not available)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe Price IDs for upsells (optional)
STRIPE_PRICE_ID_10MIN_PACK=price_...
STRIPE_PRICE_ID_30MIN_PACK=price_...
STRIPE_PRICE_ID_MONTHLY_PASS=price_...
STRIPE_PRICE_ID_NATAL_REPORT=price_...
