# Stripe — compte Astre (live). Préférer une clé restreinte rk_live_ si possible.
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Exposée au navigateur (Payment Element). Doit être la pk_live_ du même compte.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# xAI Grok API (get from https://console.x.ai)
# Model used: grok-3 (or grok-3-fast, grok-3-mini)
XAI_API_KEY=xai-...

# URL HTTPS publique (retour 3DS, Apple Pay). Jamais checkout.stripe.com.
# Ex. https://lunara-xi-drab.vercel.app ou https://callastral.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (optional - cookie auth fallback used if not configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Vercel KV (optional - fallback if Supabase not available)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe Price IDs for upsells (optional)
STRIPE_PRICE_ID_10MIN_PACK=price_...
STRIPE_PRICE_ID_30MIN_PACK=price_...
STRIPE_PRICE_ID_MONTHLY_PASS=price_...
STRIPE_PRICE_ID_NATAL_REPORT=price_...
